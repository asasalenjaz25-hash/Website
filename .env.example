# Stripe secret key for online card payment in the shop (/checkout).
# Use a test key (sk_test_...) locally; set the live key on the host.
# Without it, checkout falls back to sending the order on WhatsApp.
STRIPE_SECRET_KEY=

# Optional: public site URL for Stripe's return links, e.g. https://www.example.ae
# Defaults to the URL the request came in on.
SITE_URL=
